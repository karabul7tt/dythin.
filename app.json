{
  "expo": {
    "name": "Dythin",
    "slug": "dythin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dythin.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dythin.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a12"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotoğraf yükleyebilmek için fotoğraf arşivine erişim izni gerekir."
        }
      ],
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7bea319-3747-4543-8ef1-503ca5d49a12"
      }
    },
    "owner": "karabul7tt"
  }
}
